# Process and HTTP server
WAVEFORM_ENVIRONMENT=development
WAVEFORM_BIND_ADDR=127.0.0.1:8080
WAVEFORM_JSON_BODY_LIMIT_BYTES=65536
WAVEFORM_TTS_DEADLINE_SECONDS=300
WAVEFORM_STT_DEADLINE_SECONDS=600
WAVEFORM_MAX_IN_FLIGHT=256
WAVEFORM_SHUTDOWN_TIMEOUT_SECONDS=30

# PostgreSQL is authoritative for idempotency. Production must use
# sslmode=verify-full and independently managed credentials.
WAVEFORM_DATABASE_URL=postgres://silicon_waveform:silicon_waveform@127.0.0.1:5432/silicon_waveform
WAVEFORM_DATABASE_MAX_CONNECTIONS=16
WAVEFORM_DATABASE_MIN_CONNECTIONS=1
WAVEFORM_DATABASE_ACQUIRE_TIMEOUT_SECONDS=3
WAVEFORM_DATABASE_STATEMENT_TIMEOUT_SECONDS=10

# Silicon IAM. The app secret is a service credential and must never be logged.
WAVEFORM_IAM_BASE_URL=http://127.0.0.1:8081
WAVEFORM_IAM_APP_ID=waveform
WAVEFORM_IAM_APP_SECRET=replace-with-a-development-only-secret
WAVEFORM_IAM_TOKEN_INTROSPECTION_PATH=/api/v1/auth/tokens/introspect
WAVEFORM_IAM_OBO_VERIFY_PATH=/api/v1/obo-access/verify
WAVEFORM_IAM_AUDIENCE=waveform
WAVEFORM_IAM_TTS_ACTION=waveform.tts
WAVEFORM_IAM_STT_ACTION=waveform.stt
WAVEFORM_IAM_TIMEOUT_SECONDS=5

# Silicon Briefcase. Public file origins must be HTTPS and contain only scheme,
# host, and optional port. Local Briefcase must expose TLS for these references.
WAVEFORM_BRIEFCASE_BASE_URL=http://127.0.0.1:8082
WAVEFORM_BRIEFCASE_PERMANENT_ORIGIN=https://127.0.0.1:8082
WAVEFORM_BRIEFCASE_CDN_ORIGIN=https://127.0.0.1:8082
WAVEFORM_BRIEFCASE_APP_ID=waveform
WAVEFORM_BRIEFCASE_TIMEOUT_SECONDS=10
WAVEFORM_BRIEFCASE_DOWNLOAD_TIMEOUT_SECONDS=30
WAVEFORM_BRIEFCASE_MAX_DOWNLOAD_BYTES=26214400

# Speech providers. Empty keys disable a provider in development. Production
# requires the complete documented fallback chain.
WAVEFORM_REQUIRE_FULL_PROVIDER_CHAIN=false
WAVEFORM_GEMINI_API_KEY=
WAVEFORM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
WAVEFORM_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
WAVEFORM_GEMINI_STT_MODEL=gemini-3.5-transcribe
WAVEFORM_GEMINI_TTS_VOICE=Kore
WAVEFORM_GEMINI_TTS_TIMEOUT_SECONDS=45
WAVEFORM_GEMINI_STT_TIMEOUT_SECONDS=180
WAVEFORM_GEMINI_MAX_CONCURRENCY=16
WAVEFORM_ELEVENLABS_API_KEY=
WAVEFORM_ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
WAVEFORM_ELEVENLABS_MODEL=eleven_multilingual_v2
WAVEFORM_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
WAVEFORM_ELEVENLABS_ENABLE_LOGGING=false
WAVEFORM_ELEVENLABS_TIMEOUT_SECONDS=45
WAVEFORM_ELEVENLABS_MAX_CONCURRENCY=16
WAVEFORM_OPENAI_API_KEY=
WAVEFORM_OPENAI_BASE_URL=https://api.openai.com/v1
WAVEFORM_OPENAI_TTS_MODEL=tts-1
WAVEFORM_OPENAI_STT_MODEL=gpt-transcribe
WAVEFORM_OPENAI_TTS_VOICE=alloy
WAVEFORM_OPENAI_TTS_TIMEOUT_SECONDS=45
WAVEFORM_OPENAI_STT_TIMEOUT_SECONDS=120
WAVEFORM_OPENAI_MAX_CONCURRENCY=16
WAVEFORM_DEEPGRAM_API_KEY=
WAVEFORM_DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
WAVEFORM_DEEPGRAM_STT_MODEL=nova-3
WAVEFORM_DEEPGRAM_MIP_OPT_OUT=true
WAVEFORM_DEEPGRAM_TIMEOUT_SECONDS=120
WAVEFORM_DEEPGRAM_MAX_CONCURRENCY=16

# Bounded synchronous processing
WAVEFORM_MAX_TEXT_CHARS=4096
WAVEFORM_MAX_MEDIA_BYTES=26214400
WAVEFORM_FFMPEG_PATH=ffmpeg
WAVEFORM_AUDIO_TIMEOUT_SECONDS=30
WAVEFORM_AUDIO_MAX_INPUT_BYTES=26214400
WAVEFORM_AUDIO_MAX_OUTPUT_BYTES=26214400
WAVEFORM_AUDIO_BITRATE_KBPS=128

# Shared idempotency lifecycle
# Generate an independent high-entropy value and retain it through key rotation
# for at least the longest configured idempotency TTL.
WAVEFORM_IDEMPOTENCY_DIGEST_KEY=replace-with-an-independent-32-byte-minimum-secret
WAVEFORM_IDEMPOTENCY_TTL_SECONDS=86400
WAVEFORM_IDEMPOTENCY_LEASE_SECONDS=600
WAVEFORM_IDEMPOTENCY_RETRY_AFTER_SECONDS=2
WAVEFORM_IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=300
WAVEFORM_IDEMPOTENCY_CLEANUP_BATCH=1000

# Production validation requires JSON logs.
WAVEFORM_LOG_FILTER=silicon_waveform=info,tower_http=info
WAVEFORM_LOG_JSON=false
